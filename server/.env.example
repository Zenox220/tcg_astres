# URL PostgreSQL fournie par Render. Utilisez l'URL interne lorsque le backend
# et la base sont dans la même région Render.
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote/nom_base

# Adresse GitHub Pages autorisée. Plusieurs adresses : séparez-les par une virgule.
CORS_ORIGINS=https://votre-pseudo.github.io

# Sur Render, laissez true. Pour PostgreSQL local sans TLS, utilisez false.
DATABASE_SSL=true
